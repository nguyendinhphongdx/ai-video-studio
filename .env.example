# Copy file này thành .env nếu cần (không bắt buộc).
# AI viết kịch bản (nhà cung cấp, model, API key) cài trong ứng dụng: nút ⚙️ Cài đặt.
# Các biến dưới đây chỉ là dự phòng, dùng khi ⚙️ Cài đặt để trống.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Model Claude dự phòng (mặc định claude-opus-5-5)
# AVS_MODEL=claude-opus-5-5
# Cổng giao diện web (mặc định 3210)
# AVS_PORT=3210
# Tắt giọng đọc: AVS_TTS=none
# Đường dẫn Chrome headless shell nếu muốn dùng bản có sẵn (bình thường để trống, phần mềm tự tải)
# AVS_BROWSER=
# Cổng nội bộ Remotion dùng khi render (mặc định 3220, đổi nếu bị trùng)
# AVS_REMOTION_PORT=3220

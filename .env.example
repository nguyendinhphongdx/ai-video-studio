# Deploy (docker compose): the domain Caddy serves over HTTPS, and an email for Let's Encrypt notices.
# DOMAIN=studio.example.com
# ACME_EMAIL=you@example.com
# Database password for the postgres service in docker-compose.yml (required there). Or point DATABASE_URL at a managed
# Postgres (Neon, Supabase, RDS…). In development DATABASE_URL defaults to the docker-compose.dev.yml database.
# POSTGRES_PASSWORD=
# DATABASE_URL=postgres://user:password@host:5432/db
# Object storage for pictures, voices and videos (S3, Cloudflare R2, …). Unset: they stay in data/media only.
# Cloudflare R2: S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com and S3_REGION=auto.
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=

# Copy thành .env nếu cần (không bắt buộc).
# AI viết kịch bản (nhà cung cấp, model, API key) cài trong ứng dụng: trang Cài đặt.
# Các biến dưới đây chỉ là dự phòng khi trang Cài đặt để trống.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# AVS_MODEL=claude-opus-5-5
# Thư mục dữ liệu (mặc định ./data)
# AVS_DATA_DIR=
# Đường dẫn edge-tts nếu không có trong PATH; AVS_TTS=none để tắt giọng đọc
# AVS_EDGE_TTS=
# Chrome headless shell có sẵn (bình thường để trống, Remotion tự tải)
# AVS_BROWSER=
# Cổng nội bộ Remotion dùng khi render (mặc định 3220)
# AVS_REMOTION_PORT=3220

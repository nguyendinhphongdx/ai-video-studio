# Copy thành .env nếu cần (không bắt buộc).
# AI viết kịch bản (nhà cung cấp, model, API key) cài trong ứng dụng: trang Cài đặt.
# Các biến dưới đây chỉ là dự phòng khi trang Cài đặt để trống.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# AVS_MODEL=claude-opus-5-5
# Thư mục dữ liệu (mặc định ./data)
# AVS_DATA_DIR=
# Đường dẫn edge-tts nếu không có trong PATH; AVS_TTS=none để tắt giọng đọc
# AVS_EDGE_TTS=
# Chrome headless shell có sẵn (bình thường để trống, Remotion tự tải)
# AVS_BROWSER=
# Cổng nội bộ Remotion dùng khi render (mặc định 3220)
# AVS_REMOTION_PORT=3220

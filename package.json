{
  "name": "ai-video-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-centric video studio: idea -> AI script -> human approval -> voice -> Remotion/HyperFrames render -> human approval -> publish kit",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "next dev -H 127.0.0.1 -p 3300",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "build": "next build",
    "start": "concurrently -k -n web,worker \"next start -H 127.0.0.1 -p 3300\" \"tsx --env-file-if-exists=.env src/worker/index.ts\"",
    "typecheck": "tsc --noEmit",
    "studio": "remotion studio remotion/index.ts",
    "test": "vitest run",
    "lint": "eslint src tests",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:generate": "drizzle-kit generate",
    "db:import-sqlite": "tsx scripts/sqlite-to-postgres.ts",
    "db:dev": "docker compose -f docker-compose.tunnel.yml up -d postgres",
    "media:upload": "tsx --env-file-if-exists=.env scripts/media-upload.ts",
    "stack": "docker compose -f docker-compose.tunnel.yml up -d --build"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.5",
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@remotion/bundler": "^4.0.547",
    "@remotion/cli": "^4.0.547",
    "@remotion/fonts": "^4.0.547",
    "@remotion/media-parser": "^4.0.547",
    "@remotion/player": "^4.0.547",
    "@remotion/renderer": "^4.0.547",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "gsap": "^3.14.2",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "openai": "^7.43.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-use-measure": "^2.1.7",
    "remotion": "^4.0.547",
    "sonner": "^2.0.8",
    "streamdown": "^2.8.1",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@next/eslint-plugin-next": "^16.4.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
